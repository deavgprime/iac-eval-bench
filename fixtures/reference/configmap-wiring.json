{
  "resources": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api",
        "namespace": "bench"
      },
      "spec": {
        "replicas": 3,
        "selector": {
          "matchLabels": {
            "app": "api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "api"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "app",
                "image": "nginx:1.28.0",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "initialDelaySeconds": 5
                },
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "api-config"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "api-config",
        "namespace": "bench"
      },
      "immutable": true,
      "data": {
        "LOG_LEVEL": "info",
        "PORT": "8080"
      }
    }
  ]
}
